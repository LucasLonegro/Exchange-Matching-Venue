# Profile "full": scripts/local-up.sh --full sources this after common.env, pointing the services at
# the infrastructure of deploy/local/docker-compose.yml (start it first:
#   docker compose -f deploy/local/docker-compose.yml up -d).
# Keys marked CONFIRMED exist in the module source; the others follow ARCHITECTURE.md 5.5
# (lmb.posttrade.<sink>.enabled) and NEED RECONCILING with docs/modules/posttrade.md when it lands.

# Control plane: PostgreSQL instead of the H2 file (CONFIRMED: lmb.db.url, lmb.db.user, lmb.db.password).
LMB_DB_URL=jdbc:postgresql://127.0.0.1:5432/lmb
LMB_DB_USER=lmb
LMB_DB_PASSWORD=lmb-local-only

# Ledger: PostgreSQL instead of the H2 file (CONFIRMED: lmb.ledger.db.url, .user, .password). Same database as the
# control plane; the ledger only touches its own ledger_* tables.
LMB_LEDGER_DB_URL=jdbc:postgresql://127.0.0.1:5432/lmb
LMB_LEDGER_DB_USER=lmb
LMB_LEDGER_DB_PASSWORD=lmb-local-only

# Access service: PostgreSQL instead of the H2 file (CONFIRMED: lmb.access.db.url, .user, .password). Same database;
# it only touches its own access_* tables.
LMB_ACCESS_DB_URL=jdbc:postgresql://127.0.0.1:5432/lmb
LMB_ACCESS_DB_USER=lmb
LMB_ACCESS_DB_PASSWORD=lmb-local-only

# Post-trade sinks (guessed key names).
LMB_POSTTRADE_KAFKA_ENABLED=true
LMB_POSTTRADE_KAFKA_BOOTSTRAPSERVERS=127.0.0.1:19092
LMB_POSTTRADE_WORM_ENABLED=true
LMB_POSTTRADE_WORM_ENDPOINT=http://127.0.0.1:9002
LMB_POSTTRADE_WORM_BUCKET=lmb-worm
LMB_POSTTRADE_WORM_REGION=us-east-1
LMB_POSTTRADE_WORM_ACCESSKEY=lmb-local
LMB_POSTTRADE_WORM_SECRETKEY=lmb-local-secret
LMB_POSTTRADE_WORM_PATHSTYLE=true
LMB_POSTTRADE_CLICKHOUSE_ENABLED=true
LMB_POSTTRADE_CLICKHOUSE_URL=jdbc:clickhouse://127.0.0.1:8123/lmb
LMB_POSTTRADE_CLICKHOUSE_USER=lmb
LMB_POSTTRADE_CLICKHOUSE_PASSWORD=lmb-local-only
LMB_POSTTRADE_DROPCOPY_ENABLED=true
