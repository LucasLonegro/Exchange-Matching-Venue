# Sourced (bash, set -a) into every process started by scripts/local-up.sh, before the profile file
# (full.env), deploy/local/<service>.env and deploy/local/<name>.env. Keep it laptop-friendly.
# Any LMB_<KEY> variable here becomes configuration key lmb.<key> (io.lmb.common.Config).

# JVM non-heap caps so ~16 JVMs fit in ~3 GB (heap is LMB_HEAP, set per service by local-up.sh).
# lmb-run already adds -XX:+UseSerialGC. Service files should append: LMB_JAVA_OPTS="$LMB_JAVA_OPTS ...".
LMB_JAVA_OPTS="-XX:MaxMetaspaceSize=96m -XX:ReservedCodeCacheSize=48m -XX:MaxDirectMemorySize=96m -Xss512k -XX:CICompilerCount=2 -XX:+PerfDisableSharedMem -XX:+ExitOnOutOfMemoryError"

# Aeron, for clients and embedded drivers the modules do not configure themselves: small term
# buffers, sparse files, one shared driver thread, clean directories. cluster-node has its own keys
# (lmb.driver.termLength=256k, lmb.cluster.logTermLength=1m, lmb.driver.threading=SHARED by default).
LMB_COMMON_ARGS="-Daeron.term.buffer.length=262144 -Daeron.ipc.term.buffer.length=262144 -Daeron.term.buffer.sparse.file=true -Daeron.threading.mode=SHARED -Daeron.archive.threading.mode=SHARED -Daeron.dir.delete.on.start=true -Daeron.dir.delete.on.shutdown=true"

# Locally there is no PTP; NBBO staleness is looser than production's 5 ms (ARCHITECTURE 5.3).
LMB_NBBO_STALENS=${LMB_NBBO_STALENS:-250000000}
