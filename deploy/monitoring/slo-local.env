# Local profile thresholds: a laptop running ~16 JVMs is not a latency reference; these only catch
# gross breakage (stuck shard, divergence, dead process). No PTP and no zones locally.
ACK_P99_SECONDS=0.05
ACK_P999_SECONDS=0.25
SERVICE_TIME_P99_SECONDS=0.005
LATENCY_FOR=5m
NO_LEADER_FOR=10s
FAILOVER_SECONDS=10
ELECTIONS_PER_HOUR=10
MEMBERS=2
MEMBER_DOWN_FOR=15s
MEMBER_DOWN_SEVERITY=warning
EVENT_SEQ_SPREAD=1000000
REPLAYER_LAG_EVENTS=1000000
FEED_GAP_RATIO=0.01
REPLICATION_LAG_BYTES=16777216
INFLIGHT_RATIO=0.9
UTILISATION=0.8
SINK_LAG_EVENTS=1000000
TARGET_DOWN_FOR=30s
