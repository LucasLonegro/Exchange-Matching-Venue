{
  "title": "LMB venue",
  "uid": "lmb-venue",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "tags": [
    "lmb"
  ],
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "refresh": "10s",
  "annotations": {
    "list": []
  },
  "templating": {
    "list": [
      {
        "name": "datasource",
        "type": "datasource",
        "query": "prometheus",
        "label": "Prometheus",
        "current": {
          "text": "lmb-prometheus",
          "value": "lmb-prometheus"
        }
      },
      {
        "name": "shard",
        "type": "query",
        "label": "Shard",
        "includeAll": true,
        "multi": true,
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "query": {
          "query": "label_values(lmb:shard_members_up, shard)",
          "refId": "shards"
        },
        "definition": "label_values(lmb:shard_members_up, shard)",
        "refresh": 2,
        "current": {
          "text": "All",
          "value": "$__all"
        }
      }
    ]
  },
  "panels": [
    {
      "type": "row",
      "title": "Shards",
      "id": 1,
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "panels": []
    },
    {
      "type": "stat",
      "title": "Leaders per shard",
      "id": 2,
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {},
      "targets": [
        {
          "refId": "A",
          "expr": "lmb:shard_leaders{shard=~\"$shard\"}",
          "legendFormat": "shard {{shard}}"
        }
      ]
    },
    {
      "type": "stat",
