# Production SLO thresholds (bare-metal shape, leaders in one AZ). Seconds unless stated.
# Rendered into generated/alerts-prod.yml by render.py. Revisit after measuring the real hardware.
ACK_P50_SECONDS=0.00005
ACK_P99_SECONDS=0.0002
ACK_P999_SECONDS=0.001
SERVICE_TIME_P99_SECONDS=0.00002
COMMIT_P99_SECONDS=0.0005
MD_DELAY_P99_SECONDS=0.0001
LATENCY_FOR=2m
NO_LEADER_FOR=5s
FAILOVER_SECONDS=2
ELECTIONS_PER_HOUR=2
MEMBERS=3
MEMBER_DOWN_FOR=30s
MEMBER_DOWN_SEVERITY=page
PREFERRED_LEADER_ZONE=az-a
EVENT_SEQ_SPREAD=100000
REPLAYER_LAG_EVENTS=100000
FEED_GAP_RATIO=0.0001
# MiFID II RTS 25: 100 us max divergence from UTC for HFT activity; warn at 10 us.
PTP_WARN_SECONDS=0.00001
PTP_PAGE_SECONDS=0.0001
REPLICATION_LAG_BYTES=1048576
DR_LAG_SECONDS=5
INFLIGHT_RATIO=0.8
UTILISATION=0.5
SINK_LAG_EVENTS=1000000
# Ledger: lag in events, restarts per 15 min, how long the sink may stay closed, how long a trading date may wait
# for the other shards before its statements count as late.
LEDGER_LAG_EVENTS=1000000
LEDGER_RESTARTS_15M=3
LEDGER_DOWN_FOR=5m
LEDGER_STATEMENTS_LATE_FOR=30m
TARGET_DOWN_FOR=1m
# Access: how old a gateway's credential snapshot may get, how long no access instance may serve, gateway
# logon/query refusals per second (summed over gateways) before alerting.
ACCESS_DIRECTORY_STALE_SECONDS=300
ACCESS_DOWN_FOR=5m
AUTH_FAILURES_PER_SECOND=1
