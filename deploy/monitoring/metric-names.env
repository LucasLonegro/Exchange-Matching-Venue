# =====================================================================================================
#  THE ONE PLACE WHERE RAW SERVICE METRIC NAMES LIVE.  *** NEEDS RECONCILING WITH THE SERVICE AUTHORS ***
# =====================================================================================================
# The service modules were written in parallel with the deploy layer, so every name below is the deploy
# layer's best reading of the contract (ARCHITECTURE.md section 5: Prometheus endpoint per service,
# names `lmb_<module>_...`, latency as HdrHistogram-derived quantile gauges p50/p99/p999/max).
# When a module lands, compare with its docs/modules/<module>.md and fix the value here, then run
#     python3 deploy/monitoring/render.py
# which regenerates deploy/monitoring/generated/* (recording rules, alerts, dashboard, scrape configs).
# Alerts and dashboards never use these names directly: they use the `lmb:*` recording rules, so a
# rename only touches this file. The shell scripts (local-status.sh, kill-leader.sh) source it too.
#
# Format: KEY=value, one per line, no quotes, no spaces in values (parsed by bash and by render.py).
# An empty value disables whatever uses it.

# ---- label and unit conventions --------------------------------------------------------------------
SHARD_LABEL=shard
MEMBER_LABEL=member
QUANTILE_LABEL=quantile
Q_P50=0.5
Q_P99=0.99
Q_P999=0.999
Q_MAX=max
# Multiply a latency gauge by this to get seconds (gauges are assumed to be in nanoseconds).
LATENCY_TO_SECONDS=1e-9

# ---- cluster-node (one endpoint per member, on memberBasePort + METRICS_OFFSET) --------------------
# Role of this member, Aeron io.aeron.cluster.service.Cluster.Role codes: 0 follower, 1 candidate, 2 leader.
CLUSTER_ROLE=lmb_cluster_node_role
# Alternative a member may expose instead: id of the member it believes is leader (-1 when none).
CLUSTER_LEADER_MEMBER_ID=lmb_cluster_leader_member_id
# Ingress receive -> entry committed and applied by the state machine (labels: shard, quantile).
CLUSTER_COMMIT_LATENCY=lmb_cluster_commit_latency_ns
CLUSTER_ELECTIONS_TOTAL=lmb_cluster_elections_total
# Duration of the most recent election (ns), i.e. the failover time seen by the cluster.
CLUSTER_LAST_ELECTION_NS=lmb_cluster_last_election_duration_ns
# Bytes this member's appended log position is behind the leader's commit position.
CLUSTER_REPLICATION_LAG_BYTES=lmb_cluster_replication_lag_bytes
# Fraction of time the clustered service thread (the matcher) is busy, 0..1.
CLUSTER_SERVICE_BUSY_RATIO=lmb_cluster_service_busy_ratio
CLUSTER_COMMANDS_TOTAL=lmb_cluster_commands_total
CLUSTER_EVENTS_TOTAL=lmb_cluster_events_total
CLUSTER_LAST_EVENT_SEQ=lmb_cluster_last_event_seq
CLUSTER_SNAPSHOT_TIMESTAMP_SECONDS=lmb_cluster_last_snapshot_timestamp_seconds
# DR ClusterBackup (ClusterBackupMain): how far the backup's copy of the log trails the live log.
BACKUP_LAG_SECONDS=lmb_cluster_backup_lag_seconds
BACKUP_LAG_BYTES=lmb_cluster_backup_lag_bytes

# ---- gateway ----------------------------------------------------------------------------------------
# Gateway receive -> execution report sent (labels: shard, quantile).
GATEWAY_ACK_LATENCY=lmb_gateway_ack_latency_ns
GATEWAY_INFLIGHT_DEPTH=lmb_gateway_inflight_depth
GATEWAY_INFLIGHT_CAPACITY=lmb_gateway_inflight_capacity
GATEWAY_REJECTS_TOTAL=lmb_gateway_rejects_total
GATEWAY_SESSIONS=lmb_gateway_sessions_active
GATEWAY_RESUBMITS_TOTAL=lmb_gateway_resubmits_total

# ---- market data publisher ----------------------------------------------------------------------------
# Event cluster timestamp -> packet written to the wire (labels: quantile; maybe feed).
MD_PUBLISH_DELAY=lmb_marketdata_publish_delay_ns
MD_PACKETS_TOTAL=lmb_marketdata_packets_total
MD_RETRANSMIT_REQUESTS_TOTAL=lmb_marketdata_retransmit_requests_total

# ---- feeds / NBBO consolidator --------------------------------------------------------------------------
FEED_MESSAGES_TOTAL=lmb_feeds_messages_total
FEED_GAPS_TOTAL=lmb_feeds_gaps_total
FEED_VENUE_STALE=lmb_feeds_venue_stale
FEED_REFERENCE_PRICES_TOTAL=lmb_feeds_reference_prices_submitted_total

# ---- control plane ----------------------------------------------------------------------------------------
# 1 on the instance that holds the database lock (runs the scheduler and the risk-budget allocator).
CONTROLPLANE_LOCK_HELD=lmb_controlplane_lock_held

# ---- post-trade -----------------------------------------------------------------------------------------
# Events between the shard's last eventSeq and the sink's persisted cursor (labels: sink, shard).
POSTTRADE_SINK_LAG_EVENTS=lmb_posttrade_sink_lag_events

# ---- shadow replayer ------------------------------------------------------------------------------------
REPLAYER_DIVERGENCE_TOTAL=lmb_replayer_divergence_total
REPLAYER_LAG_EVENTS=lmb_replayer_lag_events

# ---- host (not a JVM: deploy/bin/lmb-ptp-exporter writes it for node_exporter's textfile collector) ----
PTP_OFFSET=lmb_host_ptp_offset_ns
PTP_OFFSET_TO_SECONDS=1e-9
