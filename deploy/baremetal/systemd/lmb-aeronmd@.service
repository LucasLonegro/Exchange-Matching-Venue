# Aeron C media driver for one LMB process (lmb-aeronmd@<service>-<id>), started before it.
# Cores: AERON_CONDUCTOR_CPU_AFFINITY / AERON_SENDER_CPU_AFFINITY / AERON_RECEIVER_CPU_AFFINITY in
# /etc/lmb/aeronmd/<service>-<id>.env (isolated cores; see aeronmd.env.example).
[Unit]
Description=Aeron media driver for LMB %i
Before=lmb@%i.service
After=network-online.target
Wants=network-online.target
PartOf=lmb.target

[Service]
Type=exec
User=lmb
Group=lmb
Environment=AERON_DIR=/dev/shm/aeron-%i
Environment=AERON_DIR_DELETE_ON_START=1
Environment=AERON_DIR_DELETE_ON_SHUTDOWN=1
EnvironmentFile=-/etc/lmb/aeronmd/common.env
EnvironmentFile=-/etc/lmb/aeronmd/%i.env
ExecStart=/opt/lmb/bin/aeronmd
ExecStartPost=/bin/sh -c 'for i in $(seq 1 100); do [ -f "$AERON_DIR/cnc.dat" ] && exit 0; sleep 0.1; done; exit 1'
Restart=on-failure
RestartSec=2
TimeoutStopSec=20
LimitMEMLOCK=infinity
LimitNOFILE=1048576
AmbientCapabilities=CAP_IPC_LOCK CAP_SYS_NICE
CapabilityBoundingSet=CAP_IPC_LOCK CAP_SYS_NICE
NoNewPrivileges=yes
OOMScoreAdjust=-900
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/dev/shm
SyslogIdentifier=aeronmd-%i
