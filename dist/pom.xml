<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>io.lmb</groupId>
    <artifactId>lmb-venue</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>
  <artifactId>lmb-dist</artifactId>
  <packaging>pom</packaging>
  <name>LMB distribution: every service on one classpath under dist/target/lmb/lib</name>

  <dependencies>
    <dependency><groupId>io.lmb</groupId><artifactId>lmb-matcher-core</artifactId></dependency>
    <dependency><groupId>io.lmb</groupId><artifactId>lmb-cluster-client</artifactId></dependency>
    <dependency><groupId>io.lmb</groupId><artifactId>lmb-cluster-node</artifactId></dependency>
    <dependency><groupId>io.lmb</groupId><artifactId>lmb-gateway</artifactId></dependency>
    <dependency><groupId>io.lmb</groupId><artifactId>lmb-marketdata</artifactId></dependency>
    <dependency><groupId>io.lmb</groupId><artifactId>lmb-feeds</artifactId></dependency>
    <dependency><groupId>io.lmb</groupId><artifactId>lmb-controlplane</artifactId></dependency>
    <dependency><groupId>io.lmb</groupId><artifactId>lmb-posttrade</artifactId></dependency>
    <dependency><groupId>io.lmb</groupId><artifactId>lmb-ledger</artifactId></dependency>
    <dependency><groupId>io.lmb</groupId><artifactId>lmb-replayer</artifactId></dependency>
    <dependency><groupId>io.lmb</groupId><artifactId>lmb-tools</artifactId></dependency>
    <dependency><groupId>ch.qos.logback</groupId><artifactId>logback-classic</artifactId><scope>runtime</scope></dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-dependency-plugin</artifactId>
        <executions>
          <execution>
            <id>assemble-lib</id>
            <phase>package</phase>
            <goals><goal>copy-dependencies</goal></goals>
            <configuration>
              <outputDirectory>${project.build.directory}/lmb/lib</outputDirectory>
              <includeScope>runtime</includeScope>
              <overWriteSnapshots>true</overWriteSnapshots>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
