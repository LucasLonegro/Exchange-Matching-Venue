<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>io.lmb</groupId>
    <artifactId>lmb-venue</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>
  <artifactId>lmb-fix-codecs</artifactId>
  <name>LMB FIX codecs generated by Artio</name>

  <properties>
    <fix.dictionary.file>${project.basedir}/src/main/resources/fix/lmb-fix44.xml</fix.dictionary.file>
    <fix.output.dir>${project.build.directory}/generated-sources/fix</fix.output.dir>
  </properties>

  <dependencies>
    <dependency><groupId>uk.co.real-logic</groupId><artifactId>artio-codecs</artifactId></dependency>
  </dependencies>

  <build>
    <plugins>
      <!--
        Artio's CodecGenerationTool turns the dictionary into encoders (io.lmb.fix.builder),
        decoders (io.lmb.fix.decoder), enums and io.lmb.fix.FixDictionaryImpl. The parent package
        keeps them apart from Artio's own uk.co.real_logic.artio session codecs on the shared classpath.
      -->
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>exec-maven-plugin</artifactId>
        <executions>
          <execution>
            <id>generate-fix-codecs</id>
            <phase>generate-sources</phase>
            <goals><goal>java</goal></goals>
            <configuration>
              <includeProjectDependencies>true</includeProjectDependencies>
              <includePluginDependencies>false</includePluginDependencies>
              <mainClass>uk.co.real_logic.artio.dictionary.CodecGenerationTool</mainClass>
              <systemProperties>
                <systemProperty><key>fix.codecs.parent_package</key><value>io.lmb.fix</value></systemProperty>
                <systemProperty><key>fix.codecs.tags_in_javadoc</key><value>true</value></systemProperty>
              </systemProperties>
              <arguments>
                <argument>${fix.output.dir}</argument>
                <argument>${fix.dictionary.file}</argument>
              </arguments>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>build-helper-maven-plugin</artifactId>
        <executions>
          <execution>
            <id>add-fix-sources</id>
            <phase>generate-sources</phase>
            <goals><goal>add-source</goal></goals>
            <configuration>
              <sources><source>${fix.output.dir}</source></sources>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
